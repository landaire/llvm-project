; Inline asm can name v32-v127 with vmx128. v100 is callee-saved on the Xbox
; 360 only.
define void @asm_high(ptr %p) {
; VMX128-LABEL: asm_high:
; VMX128:       # %bb.0:
; VMX128-NEXT:    li %r12, -464
; VMX128-NEXT:    stvx128 %v100, %r1, %r12
; VMX128-NEXT:    .cfi_offset v100, -464
; VMX128-NEXT:    stwu %r1, -480(%r1)
; VMX128-NEXT:    .cfi_def_cfa_offset 480
; VMX128-NEXT:    lvx128 %v40, 0, %r3
; VMX128-NEXT:    #APP
; VMX128-NEXT:    vaddfp128 %v100, %v40, %v40
; VMX128-NEXT:    #NO_APP
; VMX128-NEXT:    stvx128 %v100, 0, %r3
; VMX128-NEXT:    li %r3, 16
; VMX128-NEXT:    lvx128 %v100, %r1, %r3 # 16-byte Folded Reload
; VMX128-NEXT:    addi %r1, %r1, 480
; VMX128-NEXT:    blr
;
; VMX128-32-LABEL: asm_high:
; VMX128-32:       # %bb.0:
; VMX128-32-NEXT:    lvx128 %v40, 0, %r3
; VMX128-32-NEXT:    #APP
; VMX128-32-NEXT:    vaddfp128 %v100, %v40, %v40
; VMX128-32-NEXT:    #NO_APP
; VMX128-32-NEXT:    stvx128 %v100, 0, %r3
; VMX128-32-NEXT:    blr
  %a = load <4 x float>, ptr %p
  %r = call <4 x float> asm "vaddfp128 $0, $1, $1", "={v100},{v40}"(<4 x float> %a)
  store <4 x float> %r, ptr %p
  ret void
}

