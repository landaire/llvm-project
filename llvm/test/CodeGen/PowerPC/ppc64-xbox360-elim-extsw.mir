# RUN: llc -mtriple=powerpc64-unknown-xbox360 -run-pass=ppc-mi-peepholes -ppc-eliminate-signext -verify-machineinstrs -o - %s | FileCheck %s

# The EXTSW elimination promotes LBZ to LBZ8. The address operand of LBZ8 is
# a 32-bit pointer register on the Xbox 360 and must not be widened with
# sub_32.

---
name:            elim_extsw_lbz
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: elim_extsw_lbz
    ; CHECK: [[COPY:%[0-9]+]]:gprc_and_gprc_nor0 = COPY $r3
    ; CHECK-NEXT: [[LBZ8:%[0-9]+]]:g8rc = LBZ8 0, [[COPY]] :: (load (s8))
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gprc = COPY [[LBZ8]].sub_32
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:g8rc = IMPLICIT_DEF
    ; CHECK-NEXT: [[INSERT_SUBREG:%[0-9]+]]:g8rc = INSERT_SUBREG [[DEF]], [[COPY1]], %subreg.sub_32
    ; CHECK-NEXT: $x3 = COPY [[INSERT_SUBREG]]
    %0:gprc_and_gprc_nor0 = COPY $r3
    %1:gprc = LBZ 0, %0 :: (load (s8))
    %2:g8rc = EXTSW_32_64 %1
    $x3 = COPY %2
    BLR8 implicit $lr8, implicit $rm, implicit $x3
...
