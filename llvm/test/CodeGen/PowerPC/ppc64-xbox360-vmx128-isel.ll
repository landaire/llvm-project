  %v = load <4 x float>, ptr %src, align 4
  %dst = getelementptr inbounds <4 x float>, ptr %q, i32 %i
  store <4 x float> %v, ptr %dst, align 16
  %i1 = add i32 %i, 1
  %c = icmp ne i32 %i1, %n
  br i1 %c, label %loop, label %exit

exit:
  ret void
}

